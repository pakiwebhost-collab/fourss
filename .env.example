# Copy to .env.local (development) or set on the server (production).

# Public site URL, used for canonical links, sitemap and Open Graph
SITE_URL=https://4ssecurity.pk

# First admin account, created automatically on the very first start (when the database is empty).
# Change the password from Admin > Users & Account after logging in.
ADMIN_EMAIL=admin@4ssecurity.pk
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string, 32+ characters. Signs admin login sessions.
SESSION_SECRET=

# Where the SQLite database and uploaded files are stored (default: ./data). Back this folder up.
# DATA_DIR=/var/www/4ss-data

# SMTP for emailing contact/quote/newsletter submissions. Leave blank to keep them in the admin Inbox only.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Four Stars Website <no-reply@4ssecurity.pk>"

# Only for testing a production build over plain http on localhost:
# INSECURE_COOKIES=1
